# Android fstab file for TP-Link Neffos X1 Lite (TP904a / MT6750)
#
# Mount point    fstype    device                                                        flags
/boot            emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot     flags=display="Boot";backup=1;flashimg=1
/recovery        emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery flags=display="Recovery";backup=1;flashimg=1
/system          ext4      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system   flags=display="System";backup=1;wipeingui=1
/system_image    emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system   flags=display="System Image";backup=1;flashimg=1
/cache           ext4      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cache    flags=display="Cache";backup=1;wipeingui=1;wipeduringfactoryreset=1
/data            ext4      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/userdata flags=display="Data";backup=1;wipeingui=1;encryptable=/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/metadata

# Protected Partitions / Sensitive NV data (IMEI, MAC, Radio Calibration)
# Note: Marked with wipeingui=0 to prevent accidental IMEI loss
/nvram           emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram    flags=display="NVRAM";backup=1;wipeingui=0
/nvdata          ext4      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata   flags=display="NVData";backup=1;wipeingui=0
/protect_f       ext4      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1 flags=display="Protect_F";backup=1;wipeingui=0
/protect_s       ext4      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2 flags=display="Protect_S";backup=1;wipeingui=0
/proinfo         emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/proinfo  flags=display="Proinfo";backup=1;wipeingui=0
/frp             emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp     flags=display="FRP";backup=1;wipeingui=0

# Bootloader / Low-level MTK Partitions
/bootloader      emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/lk       flags=display="Bootloader (LK)";backup=1
/bootloader2     emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/lk2      flags=display="Bootloader 2 (LK2)";backup=1;subpartitionof=/bootloader
/logo            emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/logo     flags=display="Logo";backup=1;flashimg=1
/misc            emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/para     flags=display="Misc"
/expdb           emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/expdb    flags=display="ExpDB";backup=1
/secro           emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/secro    flags=display="Secro";backup=1
/seccfg          emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/seccfg   flags=display="Seccfg"
/tee1            emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tee1     flags=display="TEE 1";backup=1
/tee2            emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/tee2     flags=display="TEE 2";backup=1;subpartitionof=/tee1
/metadata        emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/metadata flags=display="Metadata"

# Modem & Baseband Firmware
/md1img          emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1img   flags=display="Modem";backup=1;flashimg=1
/md1dsp          emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1dsp   flags=display="MD1 DSP";backup=1;subpartitionof=/md1img
/md1arm7         emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md1arm7  flags=display="MD1 ARM7";backup=1;subpartitionof=/md1img
/md3img          emmc      /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/md3img   flags=display="MD3 Modem";backup=1;subpartitionof=/md1img

# External Storage
/external_sd     auto      /dev/block/mmcblk1p1  /dev/block/mmcblk1                       flags=display="Micro SD Card";storage;wipeingui=0;removable
/usb_otg         auto      /dev/block/sda1       /dev/block/sda                           flags=display="USB OTG";storage;wipeingui=0;removable
